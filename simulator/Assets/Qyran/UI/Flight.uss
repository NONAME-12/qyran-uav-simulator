:root {
    color: rgb(37, 38, 35);
    font-size: 14px;
    -unity-font-style: normal;
}
#screen { flex-grow: 1; }
.top-bar {
    height: 62px;
    flex-direction: row;
    align-items: center;
    padding-left: 28px;
    padding-right: 24px;
    background-color: rgb(244, 243, 238);
}
.wordmark { font-size: 21px; -unity-font-style: bold; letter-spacing: 3px; margin-right: 20px; }
.product-name { font-size: 13px; }
.muted { color: rgb(101, 103, 96); }
.spacer { flex-grow: 1; }
Button {
    height: 32px;
    padding-left: 14px;
    padding-right: 14px;
    margin-left: 6px;
    margin-right: 0;
    border-width: 1px;
    border-color: rgb(205, 205, 195);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(39, 41, 36);
}
Button:hover { background-color: rgb(226, 227, 217); }
Button:active { background-color: rgb(206, 209, 196); }
Button:focus { border-color: rgb(106, 114, 94); }
.source-label { margin-right: 20px; color: rgb(94, 104, 83); font-size: 13px; }
.exercise-panel {
    position: absolute;
    top: 88px;
    left: 28px;
    width: 340px;
    padding: 16px 18px;
    background-color: rgba(244, 243, 238, 0.94);
    border-radius: 3px;
}
.scene-title { font-size: 18px; margin-bottom: 6px; }
.progress-track { margin-top: 12px; height: 3px; background-color: rgb(212, 213, 204); }
.progress-fill { height: 3px; width: 0; background-color: rgb(102, 119, 86); }
.bottom-area {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 62px;
    flex-direction: row;
    align-items: flex-end;
}
.instruments { width: 386px; background-color: rgba(244, 243, 238, 0.96); border-radius: 3px; padding: 18px; }
.metrics { flex-direction: row; }
.metric { flex-grow: 1; }
.caption { font-size: 10px; letter-spacing: 1px; color: rgb(110, 114, 103); margin-bottom: 5px; }
.metric-line { flex-direction: row; align-items: flex-end; }
.reading { font-size: 29px; }
.unit { color: rgb(112, 116, 105); margin-left: 6px; }
.flight-actions { flex-direction: row; align-items: center; margin-top: 14px; }
.arm-button { margin-left: 0; margin-right: 10px; background-color: rgb(56, 66, 49); border-color: rgb(56, 66, 49); color: rgb(250, 249, 244); }
.arm-button:hover { background-color: rgb(79, 91, 68); }
.armed .arm-button { background-color: rgb(155, 82, 50); border-color: rgb(155, 82, 50); }
.channels-panel { width: 292px; padding: 17px 18px; background-color: rgba(244, 243, 238, 0.96); border-radius: 3px; }
.panel-heading { flex-direction: row; margin-bottom: 8px; }
.channel { flex-direction: row; align-items: center; height: 24px; }
.channel-name { width: 62px; font-size: 12px; color: rgb(86, 90, 79); }
.channel-value { width: 46px; -unity-text-align: middle-right; font-size: 12px; }
.axis-track { flex-grow: 1; height: 3px; background-color: rgb(207, 210, 196); margin-left: 5px; margin-right: 12px; }
.axis-marker { position: absolute; left: 50%; top: -3px; width: 5px; height: 9px; background-color: rgb(76, 89, 61); border-radius: 1px; }
.throttle-marker { background-color: rgb(162, 88, 52); }
.help-bar { position: absolute; bottom: 0; left: 0; right: 0; height: 40px; justify-content: center; align-items: center; background-color: rgba(38, 42, 34, 0.83); color: rgb(236, 237, 226); font-size: 12px; }
.message-box { position: absolute; bottom: 238px; align-self: center; padding: 10px 18px; background-color: rgba(37, 42, 32, 0.9); color: rgb(247, 246, 237); border-radius: 3px; max-width: 650px; }
.controller-panel { position: absolute; top: 76px; bottom: 52px; right: 14px; width: 470px; background-color: rgb(244, 243, 238); border-radius: 4px; border-width: 1px; border-color: rgb(205, 207, 194); }
.settings-heading { flex-direction: row; align-items: center; padding: 14px 18px; }
.settings-title { font-size: 22px; }
.settings-scroll { padding: 0 18px 16px; }
.settings-scroll > .unity-scroll-view__content-viewport { padding-right: 6px; }
.section-title { font-size: 15px; -unity-font-style: bold; margin-top: 20px; margin-bottom: 10px; }
.device-row { flex-direction: row; align-items: center; margin-top: 10px; }
#device-field { flex-grow: 1; }
.status-text { white-space: normal; color: rgb(137, 77, 48); margin-top: 7px; font-size: 12px; }
.instruction { white-space: normal; color: rgb(101, 105, 93); margin-bottom: 10px; }
.mapping-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.mapping-label { width: 60px; font-size: 13px; }
.mapping-dropdown { flex-grow: 1; min-width: 80px; }
.reverse-toggle { width: 62px; margin-left: 6px; }
.button-row { flex-direction: row; }
.button-row Button { flex-grow: 1; margin-left: 0; margin-right: 6px; padding-left: 6px; padding-right: 6px; }
.save-button { margin-left: 0; margin-top: 10px; }
.raw-axis-row { flex-direction: row; align-items: center; margin-bottom: 4px; }
.raw-axis-name { width: 150px; font-size: 12px; }
.raw-axis-value { width: 58px; -unity-text-align: middle-right; font-size: 12px; }
.raw-axis-bar { flex-grow: 1; height: 4px; background-color: rgb(207, 210, 196); }
.raw-axis-fill { height: 4px; width: 50%; background-color: rgb(114, 126, 97); }
.keyboard-guide { color: rgb(79, 85, 70); white-space: normal; }
.hidden { display: none; }
.unity-base-field { margin-bottom: 10px; }
.unity-base-field__label { min-width: 65px; color: rgb(87, 94, 75); }
.unity-base-field__input { background-color: rgb(232, 233, 222); color: rgb(42, 47, 35); border-radius: 2px; }
.unity-toggle__input { background-color: rgba(0, 0, 0, 0); }
.unity-base-slider__tracker { background-color: rgb(206, 210, 194); }
.unity-base-slider__dragger { background-color: rgb(100, 113, 83); border-color: rgb(100, 113, 83); }
#deadzone-field, #expo-field { margin-top: 8px; }
#keyboard-throttle { margin-top: 12px; margin-bottom: 0; }
#open-telemetry { margin-left: 0; margin-bottom: 16px; }
