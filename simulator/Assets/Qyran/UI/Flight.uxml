<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Flight.uss" />
    <ui:VisualElement name="screen" picking-mode="Ignore">
        <ui:VisualElement class="top-bar">
            <ui:Label text="QYRAN" class="wordmark" />
            <ui:Label text="UAV Simulator" class="muted product-name" />
            <ui:VisualElement class="spacer" />
            <ui:Label name="input-source" text="Keyboard" class="source-label" />
            <ui:Button name="controller-button" text="Controller" />
            <ui:Button name="camera-button" text="Chase" />
            <ui:Button name="record-button" text="Record" />
            <ui:Button name="reset-button" text="Reset" />
        </ui:VisualElement>
        <ui:VisualElement class="exercise-panel" picking-mode="Ignore">
            <ui:Label text="Training yard" class="scene-title" />
            <ui:Label name="exercise" text="Take off and hold 2 m for 5 seconds" class="muted" />
            <ui:VisualElement class="progress-track">
                <ui:VisualElement name="hover-progress" class="progress-fill" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="message-box" class="message-box" picking-mode="Ignore">
            <ui:Label name="message" />
        </ui:VisualElement>
        <ui:VisualElement class="bottom-area" picking-mode="Ignore">
            <ui:VisualElement class="instruments">
                <ui:VisualElement class="metrics">
                    <ui:VisualElement class="metric">
                        <ui:Label text="ALTITUDE" class="caption" />
                        <ui:VisualElement class="metric-line"><ui:Label name="altitude" text="0.0" class="reading" /><ui:Label text="m" class="unit" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="metric">
                        <ui:Label text="SPEED" class="caption" />
                        <ui:VisualElement class="metric-line"><ui:Label name="speed" text="0.0" class="reading" /><ui:Label text="m/s" class="unit" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="metric">
                        <ui:Label text="FLIGHT" class="caption" />
                        <ui:Label name="flight-time" text="00:00" class="reading" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Slider name="keyboard-throttle" label="Throttle" low-value="0" high-value="1" value="0" />
                <ui:VisualElement class="flight-actions">
                    <ui:Button name="arm-button" text="Arm motors" class="arm-button" />
                    <ui:Label name="flight-state" text="Disarmed" class="muted" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="impacts" text="0 impacts" class="muted" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="spacer" />
            <ui:VisualElement class="channels-panel">
                <ui:VisualElement class="panel-heading"><ui:Label text="COMMANDS" class="caption" /><ui:VisualElement class="spacer" /><ui:Label name="fps" text="" class="caption" /></ui:VisualElement>
                <ui:VisualElement class="channel"><ui:Label text="Roll" class="channel-name" /><ui:VisualElement class="axis-track"><ui:VisualElement name="roll-marker" class="axis-marker" /></ui:VisualElement><ui:Label name="roll-value" text="0.00" class="channel-value" /></ui:VisualElement>
                <ui:VisualElement class="channel"><ui:Label text="Pitch" class="channel-name" /><ui:VisualElement class="axis-track"><ui:VisualElement name="pitch-marker" class="axis-marker" /></ui:VisualElement><ui:Label name="pitch-value" text="0.00" class="channel-value" /></ui:VisualElement>
                <ui:VisualElement class="channel"><ui:Label text="Yaw" class="channel-name" /><ui:VisualElement class="axis-track"><ui:VisualElement name="yaw-marker" class="axis-marker" /></ui:VisualElement><ui:Label name="yaw-value" text="0.00" class="channel-value" /></ui:VisualElement>
                <ui:VisualElement class="channel"><ui:Label text="Throttle" class="channel-name" /><ui:VisualElement class="axis-track"><ui:VisualElement name="throttle-marker" class="axis-marker throttle-marker" /></ui:VisualElement><ui:Label name="throttle-value" text="0%" class="channel-value" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="help-bar" picking-mode="Ignore">
            <ui:Label name="controls-help" text="W A S D  Tilt     Q E  Yaw     ↑ ↓  Throttle     H  50% thrust     Space  Arm     C  Camera     R  Reset" />
        </ui:VisualElement>
        <ui:VisualElement name="controller-panel" class="controller-panel hidden">
            <ui:VisualElement class="settings-heading"><ui:Label text="Controller" class="settings-title" /><ui:VisualElement class="spacer" /><ui:Button name="close-controller" text="Close" /></ui:VisualElement>
            <ui:ScrollView class="settings-scroll">
                <ui:DropdownField name="source-field" label="Input" />
                <ui:VisualElement name="keyboard-info">
                    <ui:Label text="Keyboard flight controls" class="section-title" />
                    <ui:Label text="W / S    Pitch forward / back&#10;A / D    Roll left / right&#10;Q / E    Yaw left / right&#10;↑ / ↓      Increase / decrease throttle&#10;H           Set throttle to 50%&#10;Mouse  Throttle slider on the flight panel&#10;Space   Arm / disarm motors&#10;C           Switch camera&#10;R           Reset flight&#10;L           Start / stop CSV recording" class="keyboard-guide" />
                </ui:VisualElement>
                <ui:VisualElement name="usb-settings">
                    <ui:VisualElement class="device-row"><ui:DropdownField name="device-field" label="Device" /><ui:Button name="rescan-button" text="Refresh" /></ui:VisualElement>
                    <ui:Label name="device-status" class="status-text" />
                    <ui:Label text="Channel mapping" class="section-title" />
                    <ui:VisualElement name="mapping-rows" />
                    <ui:Slider name="deadzone-field" label="Deadzone" low-value="0" high-value="0.3" value="0.04" show-input-field="true" />
                    <ui:Slider name="expo-field" label="Expo" low-value="0" high-value="1" value="0.25" show-input-field="true" />
                    <ui:Label text="Calibration" class="section-title" />
                    <ui:Label name="calibration-instruction" text="Centre roll, pitch and yaw. Keep throttle low. Capture the centre, then move all four channels to their endpoints." class="instruction" />
                    <ui:VisualElement class="button-row"><ui:Button name="centre-button" text="Capture centre" /><ui:Button name="finish-button" text="Finish range" /><ui:Button name="cancel-calibration" text="Cancel" /></ui:VisualElement>
                    <ui:Button name="save-profile" text="Save controller profile" class="save-button" />
                    <ui:Label name="profile-status" class="status-text" />
                    <ui:Label text="Raw device axes" class="section-title" />
                    <ui:VisualElement name="raw-axes" />
                </ui:VisualElement>
                <ui:Label text="Telemetry" class="section-title" />
                <ui:Label text="CSV records commands, position, velocity, attitude and collisions at the physics update rate." class="instruction" />
                <ui:Button name="open-telemetry" text="Open recordings folder" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
